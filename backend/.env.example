# Vorlage für Umgebungsvariablen. Kopieren nach .env bzw. auf dem Server /
# in Render setzen. Echte Werte NIE ins Repository einchecken.

PORT=5000

# Mailversand (ohne SMTP_HOST werden keine Mails verschickt)
SMTP_HOST=mail.bruderer.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shopfloor-alert@bruderer.com
SMTP_PASS=

# Empfänger bei Eskalation (optional, sonst Werte aus config/notifications.js)
MAIL_LVL_2=
MAIL_LVL_3=
MAIL_LVL_4=
MAIL_LVL_5=

# Link in den Mails (optional)
APP_URL=

# Nur für Vorführungen: Beispieltickets anlegen, wenn noch keine existieren
DEMO_DATA=false
